{
  "name": "nestjs-mongoose-book-manager",
  "version": "0.4.2",
  "description": "Sample NestJS application that uses monguito.",
  "author": "Josu Martinez",
  "private": true,
  "license": "MIT",
  "resolutions": {
    "**/fork-ts-checker-webpack-plugin/minimatch": "^3.1.5",
    "**/fork-ts-checker-webpack-plugin/minimatch/brace-expansion": "^1.1.18",
    "**/test-exclude/minimatch": "^3.1.5",
    "**/test-exclude/minimatch/brace-expansion": "^1.1.18",
    "**/test-exclude/glob/minimatch": "^3.1.5",
    "**/test-exclude/glob/minimatch/brace-expansion": "^1.1.18",
    "**/cosmiconfig/**/js-yaml": "^4.3.1",
    "**/@istanbuljs/load-nyc-config/**/js-yaml": "^3.15.1",
    "**/anymatch/**/picomatch": "^2.3.2"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "yarn start:db && nest start --watch",
    "start:debug": "yarn start:db && nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:db": "./mongo_scripts/dbstart.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.1",
    "class-transformer": "^0.5.1",
    "mongoose": "^9.9.3",
    "monguito": "link:../../",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-or-skip-tests": "^2.6.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.3"
  }
}
